// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum DeckType {
  CARDS_DECK
  PACKAGE_DECK
}

enum CardType {
  BASIC
  CLOZE
  OCCLUSION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MediaType {
  IMAGE
  PDF
}

model User {
  id                  Int          @id @default(autoincrement())
  email               String       @unique
  password            String
  name                String
  decks               UserDeck[]
  role                UserRole     @default(USER)
  session_code        String?
  activation_code     String?
  status              UserStatus   @default(PENDING)
  reset_password_code String?
  created_at          DateTime     @default(now())
  cards_answers       CardAnswer[]
  username             String?      @unique
  avatar_hair          String?
  avatar_hair_color    String?
  avatar_skin_color    String?
  avatar_clothing_color String?
  avatar_glasses       Boolean      @default(false)
  current_streak       Int          @default(0)
  last_study_date      DateTime?
  xp                   Int          @default(0)
  following            Follow[]     @relation("Follower")
  followers            Follow[]     @relation("Following")
  achievements         UserAchievement[]
  aiUsages             AiUsage[]
  aiSubscription       AiSubscription?
  quizzes              Quiz[]
  quizAttempts         QuizAttempt[]
  aiPayments           AiPayment[]
  activityEvents       ActivityEvent[] @relation("ActivityActor")
  activityTargets      ActivityEvent[] @relation("ActivityTarget")
  activityReactions    ActivityReaction[]
  activityComments     ActivityComment[]
  // Firebase Cloud Messaging token for this device, used to push
  // notifications (follows, achievements) even when the app is closed.
  // Nullable: not every user has granted notification permission / a
  // token hasn't been registered yet.
  fcm_token            String?
  // Friend chosen for the weekly friends quest (must follow each other).
  quest_partner_id     Int?
  // IANA timezone reported by the app (e.g. "Asia/Riyadh"). Used ONLY by the
  // mosaic layer for local calendar days; null until the app has synced it.
  timezone             String?      @db.VarChar(64)
  // Year chosen at registration (PREPARATORY = السنة التحضيرية). Null for older
  // accounts until they pick one; only users with PREPARATORY are in "Mossad".
  study_year           String?      @db.VarChar(32)
  mosaic_seasons       MosaicSeason[]
  mosaic_days          MosaicDay[]
  mosaic_pieces        MosaicPiece[]

  @@index([study_year, xp])
}

// One painting per user per artwork. The timezone is FROZEN here at season
// start so travelling cannot skip or duplicate days. start_date is the local
// calendar date (YYYY-MM-DD) of Day 1.
model MosaicSeason {
  id           Int       @id @default(autoincrement())
  user_id      Int
  artwork_id   String    @db.VarChar(64)
  timezone     String    @db.VarChar(64)
  start_date   String    @db.VarChar(10)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  user         User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, artwork_id])
}

// Per-local-day ledger. Counters only ever go up (max-snapshot) because
// CardAnswer.updated_at is overwritten on re-review and cannot be re-counted
// for past days.
model MosaicDay {
  user_id            Int
  artwork_id         String   @db.VarChar(64)
  day_index          Int
  local_date         String   @db.VarChar(10)
  reviews            Int      @default(0)
  mastered           Int      @default(0)
  chapter_done       Boolean  @default(false)
  scheduled_released Int      @default(0)
  catchup_released   Int      @default(0)
  updated_at         DateTime @default(now())
  user               User     @relation(fields: [user_id], references: [id])

  @@id([user_id, artwork_id, day_index])
}

// The 100-piece guarantee lives in these three unique keys:
// one owner per slot, one owner per piece id, one row per reward source.
model MosaicPiece {
  id          Int       @id @default(autoincrement())
  user_id     Int
  artwork_id  String    @db.VarChar(64)
  slot        Int
  piece_id    Int
  kind        String    @db.VarChar(16)
  source_key  String    @db.VarChar(64)
  season_day  Int
  earned_at   DateTime  @default(now())
  revealed_at DateTime?
  user        User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, artwork_id, slot])
  @@unique([user_id, artwork_id, piece_id])
  @@unique([user_id, artwork_id, source_key])
}

model ActivityEvent {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  created_at DateTime @default(now())
  // Set for "X followed you" events: the person who is notified in the feed.
  target_user_id Int?
  user       User     @relation("ActivityActor", fields: [user_id], references: [id])
  target     User?    @relation("ActivityTarget", fields: [target_user_id], references: [id])
  reactions  ActivityReaction[]
  comments   ActivityComment[]

  @@index([user_id])
  @@index([target_user_id])
}

// "Celebrate" on a feed post (one per user per post).
model ActivityReaction {
  event_id   Int
  user_id    Int
  created_at DateTime      @default(now())
  event      ActivityEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id])

  @@id([event_id, user_id])
  @@index([user_id])
}

model ActivityComment {
  id         Int           @id @default(autoincrement())
  event_id   Int
  user_id    Int
  text       String        @db.VarChar(300)
  created_at DateTime      @default(now())
  event      ActivityEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id])

  @@index([event_id])
}

model UserAchievement {
  user_id        Int
  achievement_id String
  unlocked_at    DateTime @default(now())
  user           User     @relation(fields: [user_id], references: [id])

  @@id([user_id, achievement_id])
}

model Deck {
  id         Int        @id @default(autoincrement())
  title      String
  cards      Card[]
  codes      CodeDeck[]
  users      UserDeck[]
  parent_id  Int?
  parent     Deck?      @relation(fields: [parent_id], references: [id], name: "deck-parent-child")
  children   Deck[]     @relation(name: "deck-parent-child")
  by_admin   Boolean    @default(false)
  type       DeckType   @default(CARDS_DECK)
  created_at DateTime   @default(now())
  public     Boolean    @default(false)
  visible    Boolean    @default(true)
  order      Int        @default(0)
}

model Card {
  id                Int          @id @default(autoincrement())
  order             Int
  deck_id           Int
  deck              Deck         @relation(fields: [deck_id], references: [id])
  type              CardType
  data              Json
  document_name     String?      @unique
  document_title    String?
  front_image_name  String?      @unique
  back_image_name   String?      @unique
  created_at        DateTime     @default(now())
  front_image_media Media?       @relation(fields: [front_image_name], references: [name], name: "front_image_media")
  back_image_media  Media?       @relation(fields: [back_image_name], references: [name], name: "back_image_media")
  document_media    Media?       @relation(fields: [document_name], references: [name], name: "document_media")
  answers           CardAnswer[]
}

enum AnswerType {
  EASY
  GOOD
  HARD
  AGAIN
  NONE
}

model CardAnswer {
  user_id    Int
  card_id    Int
  answer     AnswerType
  user       User       @relation(fields: [user_id], references: [id])
  card       Card       @relation(fields: [card_id], references: [id])
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now())

  @@id([user_id, card_id])
}

model Code {
  id         Int      @id @default(autoincrement())
  code       String   @unique @default(uuid())
  created_at DateTime @default(now())

  decks CodeDeck[]
}

model CodeDeck {
  code_id Int
  deck_id Int

  code Code @relation(fields: [code_id], references: [id])
  deck Deck @relation(fields: [deck_id], references: [id])

  @@id([code_id, deck_id])
}

model UserDeck {
  user_id           Int
  deck_id           Int
  user              User     @relation(fields: [user_id], references: [id])
  deck              Deck     @relation(fields: [deck_id], references: [id])
  editable          Boolean
  sharable          Boolean
  created_at        DateTime @default(now())
  share_code        String?  @unique
  share_is_editable Boolean?
  share_is_sharable Boolean?

  @@id([user_id, deck_id])
}

model Media {
  name          String    @id
  type          MediaType
  front_card    Card?     @relation(name: "front_image_media")
  back_card     Card?     @relation(name: "back_image_media")
  document_card Card?     @relation(name: "document_media")
  created_at    DateTime  @default(now())
}

model Follow {
  id           Int      @id @default(autoincrement())
  followerId   Int
  followingId  Int
  created_at   DateTime @default(now())
  follower     User     @relation("Follower", fields: [followerId], references: [id])
  following    User     @relation("Following", fields: [followingId], references: [id])
  @@unique([followerId, followingId])
}

/// One lifecycle record per notification the app scheduled/showed (reported by the
/// device, upserted by client_id). Lets us tell NOTIFICATION_OPENED apart from
/// STUDY_COMPLETED: opened_at / app_opened_after_notification vs
/// studied_after_notification / notification_converted_to_study.
model NotificationEvent {
  id                                 Int       @id @default(autoincrement())
  client_id                          String    @db.VarChar(64)
  user_id                            Int
  notification_type                  String    @db.VarChar(40)
  notification_pool                  String    @db.VarChar(40)
  message                            String    @db.Text
  sent_at                            DateTime
  opened_at                          DateTime?
  app_opened_after_notification      Boolean   @default(false)
  studied_after_notification         Boolean   @default(false)
  study_session_started_at           DateTime?
  cards_completed_after_notification Int       @default(0)
  notification_converted_to_study    Boolean   @default(false)
  challenge_id                       Int?
  friend_id                          Int?
  created_at                         DateTime  @default(now())
  updated_at                         DateTime  @default(now()) @updatedAt

  @@unique([user_id, client_id])
  @@index([user_id, sent_at])
  @@index([notification_pool, sent_at])
}

// ---- Automated pipeline (create cards -> polish -> pictures -> report), runs on the server ----
model PipelineJob {
  id         Int            @id @default(autoincrement())
  title      String
  status     String         @default("draft") // draft | queued | running | waiting | paused | done | error
  user_id    Int
  config     Json
  state      Json
  log        Json?
  report     Json?
  message    String?        @db.Text
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  files      PipelineFile[]
}

model PipelineFile {
  id         Int         @id @default(autoincrement())
  job_id     Int
  job        PipelineJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  lecture_id String
  seq        Int
  mime       String
  data       Bytes

  @@index([job_id, lecture_id])
}

model PipelineKey {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(300)
  role       String   @default("any") // any | write | review | pics
  created_at DateTime @default(now())
}

// ---- AI scan (photo -> flashcards / MCQ): free quota + paid subscription ----
model AiUsage {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mode       String   @db.VarChar(16) // flashcards | mcq
  created_at DateTime @default(now())

  @@index([user_id, created_at])
}

model AiSubscription {
  user_id    Int      @id
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan       String   @db.VarChar(16) // MONTHLY | YEARLY
  expires_at DateTime
  source     String   @default("admin") @db.VarChar(32) // admin | google_play | app_store | code
  ref        String?  @db.VarChar(200) // store transaction id
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ---- AI multiple-choice quizzes (own tables: old app versions never see an unknown card type) ----
model Quiz {
  id         Int            @id @default(autoincrement())
  user_id    Int
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  created_at DateTime       @default(now())
  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  @@index([user_id, created_at])
}

model QuizQuestion {
  id          Int    @id @default(autoincrement())
  quiz_id     Int
  quiz        Quiz   @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  order       Int
  question    String @db.Text
  options     Json   // string[]
  correct     Int    // 0-based index into options
  explanation String? @db.Text

  @@index([quiz_id, order])
}

model QuizAttempt {
  id         Int      @id @default(autoincrement())
  quiz_id    Int
  quiz       Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  score      Int
  total      Int
  answers    Json     // (number|null)[] chosen option per question
  created_at DateTime @default(now())

  @@index([quiz_id, user_id])
}

// ---- Manual Sham Cash payments (no public merchant API): user pays, submits proof, admin approves ----
model AiPayment {
  id          Int       @id @default(autoincrement())
  user_id     Int
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan        String    @db.VarChar(16) // MONTHLY | YEARLY
  amount_usd  Decimal   @db.Decimal(8, 2)
  method      String    @default("SHAM_CASH") @db.VarChar(24)
  reference   String    @unique @db.VarChar(16) // code the user writes in the transfer note
  status      String    @default("PENDING") @db.VarChar(16) // PENDING | SUBMITTED | APPROVED | REJECTED
  tx_id       String?   @unique @db.VarChar(100) // Sham Cash transaction number (unique: a receipt can't be reused)
  proof       Bytes?    // receipt screenshot
  proof_mime  String?   @db.VarChar(40)
  note        String?   @db.VarChar(300)
  reviewed_at DateTime?
  created_at  DateTime  @default(now())

  @@index([status, created_at])
  @@index([user_id])
}

// ---- MCQ question bank ------------------------------------------------------
// Content is written by admins (dashboard) and only READ by students.
// Ids are strings so the same stable id travels between the dashboard, the
// import file and the app (e.g. "general-surgery"). The MySQL collation is
// case-insensitive, so ids are validated as lowercase.
model McqSubject {
  id          String          @id @db.VarChar(64)
  name        String          @db.VarChar(191)
  name_en     String?         @db.VarChar(191)
  order       Int             @default(0)
  published   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  collections McqCollection[]
  questions   McqQuestion[]

  @@index([published, order])
}

// A lecture / course / chapter inside a subject.
model McqCollection {
  id         String        @id @db.VarChar(64)
  subject_id String        @db.VarChar(64)
  subject    McqSubject    @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  title      String        @db.VarChar(255)
  title_en   String?       @db.VarChar(255)
  order      Int           @default(0)
  published  Boolean       @default(true)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  questions  McqQuestion[]

  @@index([subject_id, order])
}

model McqQuestion {
  id            String        @id @db.VarChar(64)
  subject_id    String        @db.VarChar(64)
  subject       McqSubject    @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  collection_id String        @db.VarChar(64)
  collection    McqCollection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  text          String        @db.Text
  options       Json          // [{ id: string, text: string }]  (order = display order, letters A, B, C... by position)
  correct       Json          // string[] of option ids; 1 id = single answer, 2+ = multiple answer
  explanation   String?       @db.Text
  key_points    Json?         // string[]
  exam_label    String?       @db.VarChar(64)
  source        String?       @db.VarChar(255)
  order         Int           @default(0)
  published     Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@index([collection_id, order])
  @@index([subject_id])
  @@index([published])
}
