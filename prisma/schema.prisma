// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum DeckType {
  CARDS_DECK
  PACKAGE_DECK
}

enum CardType {
  BASIC
  CLOZE
  OCCLUSION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MediaType {
  IMAGE
  PDF
}

model User {
  id                  Int          @id @default(autoincrement())
  email               String       @unique
  password            String
  name                String
  decks               UserDeck[]
  role                UserRole     @default(USER)
  session_code        String?
  activation_code     String?
  status              UserStatus   @default(PENDING)
  reset_password_code String?
  created_at          DateTime     @default(now())
  cards_answers       CardAnswer[]
  username             String?      @unique
  avatar_hair          String?
  avatar_hair_color    String?
  avatar_skin_color    String?
  avatar_clothing_color String?
  avatar_glasses       Boolean      @default(false)
  current_streak       Int          @default(0)
  last_study_date      DateTime?
  xp                   Int          @default(0)
  following            Follow[]     @relation("Follower")
  followers            Follow[]     @relation("Following")
  achievements         UserAchievement[]
  activityEvents       ActivityEvent[] @relation("ActivityActor")
  activityTargets      ActivityEvent[] @relation("ActivityTarget")
  activityReactions    ActivityReaction[]
  activityComments     ActivityComment[]
  // Firebase Cloud Messaging token for this device, used to push
  // notifications (follows, achievements) even when the app is closed.
  // Nullable: not every user has granted notification permission / a
  // token hasn't been registered yet.
  fcm_token            String?
  // Friend chosen for the weekly friends quest (must follow each other).
  quest_partner_id     Int?
  // IANA timezone reported by the app (e.g. "Asia/Riyadh"). Used ONLY by the
  // mosaic layer for local calendar days; null until the app has synced it.
  timezone             String?      @db.VarChar(64)
  mosaic_seasons       MosaicSeason[]
  mosaic_days          MosaicDay[]
  mosaic_pieces        MosaicPiece[]
}

// One painting per user per artwork. The timezone is FROZEN here at season
// start so travelling cannot skip or duplicate days. start_date is the local
// calendar date (YYYY-MM-DD) of Day 1.
model MosaicSeason {
  id           Int       @id @default(autoincrement())
  user_id      Int
  artwork_id   String    @db.VarChar(64)
  timezone     String    @db.VarChar(64)
  start_date   String    @db.VarChar(10)
  started_at   DateTime  @default(now())
  completed_at DateTime?
  user         User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, artwork_id])
}

// Per-local-day ledger. Counters only ever go up (max-snapshot) because
// CardAnswer.updated_at is overwritten on re-review and cannot be re-counted
// for past days.
model MosaicDay {
  user_id            Int
  artwork_id         String   @db.VarChar(64)
  day_index          Int
  local_date         String   @db.VarChar(10)
  reviews            Int      @default(0)
  mastered           Int      @default(0)
  chapter_done       Boolean  @default(false)
  scheduled_released Int      @default(0)
  catchup_released   Int      @default(0)
  updated_at         DateTime @default(now())
  user               User     @relation(fields: [user_id], references: [id])

  @@id([user_id, artwork_id, day_index])
}

// The 100-piece guarantee lives in these three unique keys:
// one owner per slot, one owner per piece id, one row per reward source.
model MosaicPiece {
  id          Int       @id @default(autoincrement())
  user_id     Int
  artwork_id  String    @db.VarChar(64)
  slot        Int
  piece_id    Int
  kind        String    @db.VarChar(16)
  source_key  String    @db.VarChar(64)
  season_day  Int
  earned_at   DateTime  @default(now())
  revealed_at DateTime?
  user        User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, artwork_id, slot])
  @@unique([user_id, artwork_id, piece_id])
  @@unique([user_id, artwork_id, source_key])
}

model ActivityEvent {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  created_at DateTime @default(now())
  // Set for "X followed you" events: the person who is notified in the feed.
  target_user_id Int?
  user       User     @relation("ActivityActor", fields: [user_id], references: [id])
  target     User?    @relation("ActivityTarget", fields: [target_user_id], references: [id])
  reactions  ActivityReaction[]
  comments   ActivityComment[]

  @@index([user_id])
  @@index([target_user_id])
}

// "Celebrate" on a feed post (one per user per post).
model ActivityReaction {
  event_id   Int
  user_id    Int
  created_at DateTime      @default(now())
  event      ActivityEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id])

  @@id([event_id, user_id])
  @@index([user_id])
}

model ActivityComment {
  id         Int           @id @default(autoincrement())
  event_id   Int
  user_id    Int
  text       String        @db.VarChar(300)
  created_at DateTime      @default(now())
  event      ActivityEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [user_id], references: [id])

  @@index([event_id])
}

model UserAchievement {
  user_id        Int
  achievement_id String
  unlocked_at    DateTime @default(now())
  user           User     @relation(fields: [user_id], references: [id])

  @@id([user_id, achievement_id])
}

model Deck {
  id         Int        @id @default(autoincrement())
  title      String
  cards      Card[]
  codes      CodeDeck[]
  users      UserDeck[]
  parent_id  Int?
  parent     Deck?      @relation(fields: [parent_id], references: [id], name: "deck-parent-child")
  children   Deck[]     @relation(name: "deck-parent-child")
  by_admin   Boolean    @default(false)
  type       DeckType   @default(CARDS_DECK)
  created_at DateTime   @default(now())
  public     Boolean    @default(false)
  order      Int        @default(0)
}

model Card {
  id                Int          @id @default(autoincrement())
  order             Int
  deck_id           Int
  deck              Deck         @relation(fields: [deck_id], references: [id])
  type              CardType
  data              Json
  document_name     String?      @unique
  document_title    String?
  front_image_name  String?      @unique
  back_image_name   String?      @unique
  created_at        DateTime     @default(now())
  front_image_media Media?       @relation(fields: [front_image_name], references: [name], name: "front_image_media")
  back_image_media  Media?       @relation(fields: [back_image_name], references: [name], name: "back_image_media")
  document_media    Media?       @relation(fields: [document_name], references: [name], name: "document_media")
  answers           CardAnswer[]
}

enum AnswerType {
  EASY
  GOOD
  HARD
  AGAIN
  NONE
}

model CardAnswer {
  user_id    Int
  card_id    Int
  answer     AnswerType
  user       User       @relation(fields: [user_id], references: [id])
  card       Card       @relation(fields: [card_id], references: [id])
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now())

  @@id([user_id, card_id])
}

model Code {
  id         Int      @id @default(autoincrement())
  code       String   @unique @default(uuid())
  created_at DateTime @default(now())

  decks CodeDeck[]
}

model CodeDeck {
  code_id Int
  deck_id Int

  code Code @relation(fields: [code_id], references: [id])
  deck Deck @relation(fields: [deck_id], references: [id])

  @@id([code_id, deck_id])
}

model UserDeck {
  user_id           Int
  deck_id           Int
  user              User     @relation(fields: [user_id], references: [id])
  deck              Deck     @relation(fields: [deck_id], references: [id])
  editable          Boolean
  sharable          Boolean
  created_at        DateTime @default(now())
  share_code        String?  @unique
  share_is_editable Boolean?
  share_is_sharable Boolean?

  @@id([user_id, deck_id])
}

model Media {
  name          String    @id
  type          MediaType
  front_card    Card?     @relation(name: "front_image_media")
  back_card     Card?     @relation(name: "back_image_media")
  document_card Card?     @relation(name: "document_media")
  created_at    DateTime  @default(now())
}

model Follow {
  id           Int      @id @default(autoincrement())
  followerId   Int
  followingId  Int
  created_at   DateTime @default(now())
  follower     User     @relation("Follower", fields: [followerId], references: [id])
  following    User     @relation("Following", fields: [followingId], references: [id])
  @@unique([followerId, followingId])
}
